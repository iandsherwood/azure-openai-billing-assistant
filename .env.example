# Copy this file to .env and fill in your real values.
# .env is gitignored, never commit your real keys.
# Export these variables into the runner process; Python does not auto-load .env.

# Azure OpenAI, used when azure_openai.provider=azure_openai (the default).
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key-here

# (Gmail OAuth uses credentials.json + gmail_token.pickle in billing_automation/.
#  See billing_automation/GOOGLE_CLOUD_SETUP.txt for one-time setup.)

# Claude Hosted on Azure, used only when azure_openai.provider=claude_foundry.
ANTHROPIC_FOUNDRY_API_KEY=your-key-here
ANTHROPIC_FOUNDRY_RESOURCE=your-foundry-resource
# Set claude_foundry.deployment in billing_config.json to the deployment name.
