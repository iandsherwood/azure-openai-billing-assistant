# Copy this file to .env and fill in your real values.
# .env is gitignored, never commit your real keys.

# Azure OpenAI, required for bill amount extraction + variance commentary
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key-here

# (Gmail OAuth uses credentials.json + gmail_token.pickle in billing_automation/.
#  See docs/GOOGLE_CLOUD_SETUP.md for one-time setup.)
